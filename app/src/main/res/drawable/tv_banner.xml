<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fire TV & Android TV 16:9 Banner Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0D101D"
                android:centerColor="#141829"
                android:endColor="#1F263D" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- GoalTV Logo centered in 16:9 Frame -->
    <item
        android:drawable="@drawable/logo2"
        android:gravity="center"
        android:top="22dp"
        android:bottom="22dp"
        android:left="36dp"
        android:right="36dp" />
</layer-list>
